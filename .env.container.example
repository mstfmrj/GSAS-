AUTH_SECRET=replace-with-a-long-random-secret
JWT_SECRET=replace-with-another-long-random-secret
AUTH_MICROSOFT_ENTRA_ID_ID=your-microsoft-application-client-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=your-microsoft-client-secret-value
MICROSOFT_LOGIN_ENABLED=true
MICROSOFT_TENANT_ID=common
MICROSOFT_SUPER_ADMIN_EMAIL=mstf.meraj@gmail.com
